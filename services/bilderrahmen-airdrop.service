[Unit]
Description=Digitaler Bilderrahmen - Eingangs-Watcher (incoming/ -> Diashow)
After=network.target
Wants=network.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/Digitaler-Bilderrahmen

Environment=PYTHONUNBUFFERED=1

ExecStart=/usr/bin/python3 /home/pi/Digitaler-Bilderrahmen/airdrop_receiver.py

Restart=on-failure
RestartSec=15
StartLimitIntervalSec=120
StartLimitBurst=5

StandardOutput=append:/home/pi/Digitaler-Bilderrahmen/bilderrahmen.log
StandardError=append:/home/pi/Digitaler-Bilderrahmen/bilderrahmen.log

Nice=15
MemoryMax=256M

[Install]
WantedBy=multi-user.target
